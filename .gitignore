# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local sqlite database（可用 npm run db:setup 重建）
/prisma/dev.db*

# 本地工具配置
.qwen/

# 外联 agent 数据（含真实邮箱的台账/退订名单，绝不进仓库）
/scripts/outreach/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
